# Supabase project (Settings → API). The anon key is safe in the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Set to true only after enabling Google OAuth and adding its credentials in Supabase Auth.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
